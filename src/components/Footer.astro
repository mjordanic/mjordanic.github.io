---
import cv from "../content/cv.json";

const year = new Date().getFullYear();
const { email, links } = cv.contact;
---

<footer class="site-footer">
  <div class="wrap foot">
    <p>© {year} {cv.profile.name} · {cv.profile.location}</p>
    <ul>
      {links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}
      <li>{email ? <a href={`mailto:${email}`}>Email</a> : <span class="todo">Email to be confirmed</span>}</li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: var(--space-12);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-8);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  p {
    margin: 0;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .todo {
    color: var(--placeholder-ink);
    border-bottom: 1px dashed currentColor;
  }
</style>
